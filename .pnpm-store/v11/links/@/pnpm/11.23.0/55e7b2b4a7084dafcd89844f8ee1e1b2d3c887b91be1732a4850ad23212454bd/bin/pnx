#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../node_modules/pnpm/bin/pnpx.mjs" "$@"
else
  exec node  "$basedir/../node_modules/pnpm/bin/pnpx.mjs" "$@"
fi
# cmd-shim-target=/home/desenvolvedor23/projetos/DFR/baby-log/.pnpm-store/v11/links/@/pnpm/11.23.0/55e7b2b4a7084dafcd89844f8ee1e1b2d3c887b91be1732a4850ad23212454bd/node_modules/pnpm/bin/pnpx.mjs
