{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "env": [
        "DATABASE_URL"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "format": {
      "cache": false,
      "dependsOn": [
        "^format"
      ]
    },
    "format:check": {
      "dependsOn": [
        "^format:check"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
